# ---- Core ----
APP_NAME=Gmail Outreach Agent
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# ---- Database ----
# Local dev (SQLite): sqlite:///./app.db
# Production (PostgreSQL): postgresql://user:password@localhost:5432/outreach
DATABASE_URL=sqlite:///./app.db

# 32-byte url-safe base64 key used to encrypt OAuth tokens / model keys at rest.
# Generate with: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
APP_ENCRYPTION_KEY=CHANGE_ME_generate_a_32_byte_base64_key

# ---- Google OAuth 2.0 ----
# Create credentials (Web application) in Google Cloud Console.
# Authorized redirect URI MUST equal GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gmail/oauth/callback

# ---- LLM (LangGraph) ----
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- OpenClaw adapter ----
# transport: http | webhook | cli | mcp
OPENCLAW_TRANSPORT=http
OPENCLAW_ENDPOINT=
OPENCLAW_COMMAND=
OPENCLAW_API_KEY=
OPENCLAW_TIMEOUT_SECONDS=30

# ---- Safety ----
# Comma-separated restriction list for real-send recipients. Empty means no
# extra recipient restriction; a non-empty list permits only listed recipients.
RESTRICTED_RECIPIENT_ALLOWLIST=
DEFAULT_TIMEZONE=Asia/Shanghai
# MUST stay false until recipient restrictions, human confirmation, and real Gmail are verified.
ENABLE_REAL_SEND=false

# ---- Scheduler / CORS ----
ENABLE_SCHEDULER=true
POLL_INTERVAL_SECONDS=60
CORS_ORIGINS=http://localhost:3000

# ---- Secrets ----
SECRET_KEY=dev-insecure-secret-change-me
