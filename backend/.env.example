# ---- Core ----
APP_NAME=Gmail Outreach Agent
APP_ENV=development
APP_URL=http://127.0.0.1:18001
API_URL=http://127.0.0.1:18000

# ---- Database ----
# Local dev (SQLite): sqlite:///./app.db
# Production (PostgreSQL): postgresql://user:password@localhost:5432/outreach
DATABASE_URL=sqlite:///./app.db

# 32-byte url-safe base64 key used to encrypt OAuth tokens / model keys at rest.
# Generate with: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
APP_ENCRYPTION_KEY=CHANGE_ME_generate_a_32_byte_base64_key

# ---- Google OAuth 2.0 ----
# Create credentials (Web application) in Google Cloud Console.
# Legacy developer-only OAuth overrides. Formal Windows installs import a
# customer-owned Desktop app credentials.json into the current-user DPAPI store.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:18000/api/gmail/oauth/callback

# ---- LLM (LangGraph) ----
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- OpenClaw adapter ----
# transport: http | webhook | cli | mcp
OPENCLAW_TRANSPORT=http
OPENCLAW_ENDPOINT=
OPENCLAW_COMMAND=
OPENCLAW_API_KEY=
OPENCLAW_TIMEOUT_SECONDS=30

# ---- Agent Providers ----
# TACWork remains the default resident/scheduled Agent Provider.
TACWORK_SERVER_URL=http://127.0.0.1:18002
TACWORK_WEB_URL=http://127.0.0.1:18003
TACWORK_HTTP_TIMEOUT_SECONDS=15

# A DeepSeek model API by itself is not an Agent Harness. Enable this provider
# only when the endpoint implements /health, /sessions lifecycle APIs, reports
# mcp_connected=true (or capability mcp_tools), and launches scripts/mcp_server.py.
DEEPSEEK_HARNESS_URL=
DEEPSEEK_HARNESS_API_KEY=
DEEPSEEK_HARNESS_TIMEOUT_SECONDS=30
DEEPSEEK_HARNESS_MCP_ENABLED=false
DEEPSEEK_HARNESS_SCHEDULED_TAKEOVER=false
# unavailable | embedded_url | event_stream | external_url
DEEPSEEK_HARNESS_SURFACE_TYPE=unavailable
DEEPSEEK_HARNESS_SURFACE_URL=

# ---- Safety ----
# Comma-separated restriction list for real-send recipients. Empty means no
# extra recipient restriction; a non-empty list permits only listed recipients.
RESTRICTED_RECIPIENT_ALLOWLIST=
DEFAULT_TIMEZONE=Asia/Shanghai
# Legacy compatibility only. Real sending now becomes available automatically
# after a customer-owned Gmail OAuth connection succeeds; it remains subject to
# Approval, pause, suppression, sending-window, limit and idempotency gates.
ENABLE_REAL_SEND=false

# ---- Scheduler / CORS ----
ENABLE_SCHEDULER=true
POLL_INTERVAL_SECONDS=60
CORS_ORIGINS=app://email-automation,http://127.0.0.1:18001,http://localhost:18001

# ---- Secrets ----
SECRET_KEY=dev-insecure-secret-change-me
