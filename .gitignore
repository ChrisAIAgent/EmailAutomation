# ===========================================================================
# Email Automation — open-source .gitignore  (pure library form)
# ---------------------------------------------------------------------------
# This repository ships SOURCE ONLY. Everything below is a local runtime
# artifact, a bundled binary, real customer data, or a secret — none of it
# belongs in a public git history.
# ===========================================================================

# ---------------- Python ----------------
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------- Node / Next.js ----------------
node_modules/
node_modules.broken-e-drive/
.next/
.next-dev/
.next-prod/
frontend/.next-mainline-check*/
out/
coverage/
*.tsbuildinfo

# ---------------- Secrets / local config (NEVER commit) -------------------
.env
.env.*
!.env.example
*.env.bak*
opencode.jsonc
opencode.jsonc.*
!opencode.jsonc.example
.mac.env
mac.env
config/secrets/

# ---------------- Database & runtime data (REAL PII + customer email) -----
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.bak*
backend/data/
backend/app.db*
backend/config/
backend/queue/
backend/tacwork/run/

# ---------------- Bundled runtimes / binaries (~1.9 GB, NOT source) -------
offline-cache/
tools/
!backend/app/tools/
backend/app/tools/*
!backend/app/tools/__init__.py
!backend/app/tools/email_tools.py
tacwork-runtime/
installer/payload/
installer/output/
installer/*.exe
installer/prerequisites/*.exe
dist/
.portable_stage/
runtime/

# ---------------- Logs / reports / build output ---------------------------
*.log
stage-audit*.log
syntax-check.log
build-installer-*.log
runtime-build*.log
logs/

# ---------------- QA artifacts (may contain real email screenshots) -------
qa_scripts/
qa-e2e/

# ---------------- Operational backups (real data) --------------------------
Email-Automation-Reset-Backup/
TACWork-Reset-Backup/
audit/

# ---------------- Agent workspace memory (private) -------------------------
.workbuddy/
.opencode/

# ---------------- Misc -----------------------------------------------------
*.docx
TACWork-Logo-*.PNG
nul
.DS_Store
Thumbs.db

# ---------------- Portable packaging chain (excluded in library form) ------
portable-bootstrap.bat
portable-start.bat
portable-start-unified.ps1
portable-diagnose.ps1

# ---------------- Local diagnostic scratch -------------------------------
_procs.txt
_start_out.txt

